---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <section class="hero container">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> ROBOTICS & ENGINEERING · PHD RESEARCHER</p>
      <h1>Robot swarms.<br /><em>RF awareness.</em></h1>
      <p class="hero-intro">I'm <strong>Adam Morris</strong>, an Engineering Mathematics PhD researcher developing robot swarms for RF monitoring and concealed-emitter localisation.</p>
      <p class="hero-detail">Exploring autonomous sensing for defence and security through simulation and physical robotic systems.</p>
      <div class="actions"><a class="button primary" href="#projects">Explore my work <span>↗</span></a><a class="text-link" href="#contact">Get in touch <span>↗</span></a></div>
      <div class="hero-meta"><span>University of Bristol</span><span>Bristol, UK</span></div>
    </div>
    <div class="hero-visual"><div class="visual-top"><span>ADAM MORRIS</span></div><div class="portrait-placeholder"><img src={`${base}adam-morris-profile.png`} alt="Portrait of Adam Morris" width="1254" height="1254" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;display:block" /></div><div class="visual-bottom"><span>Engineering Mathematics · University of Bristol</span></div></div>
  </section>
  <div class="expertise-strip"><div class="container"><span>RESEARCH FOCUS</span><span>Swarm robotics</span><span class="strip-plus">+</span><span>RF sensing</span><span class="strip-plus">+</span><span>Defence & security</span></div></div>
  <section id="about" class="container section about"><div><p class="eyebrow">01 / ABOUT</p><h2>Spatial intelligence<br />for secure environments.</h2></div><div class="about-body"><p class="large-copy">How can a team of robots build a better understanding of the electromagnetic environment?</p><p>My PhD investigates how teams of autonomous robots can monitor and maintain the RF domain in secure environments, including localising anomalous signals from concealed adversarial transmitters.</p><p>I combine 2D simulations for swarm design, high-fidelity 3D electromagnetic propagation modelling, and ROS 2/Gazebo for robot-control simulation. I also work with physical robotic platforms, including the LEO Rover and Clearpath Jackal.</p><div class="skill-groups"><div><h3>Proficient</h3><p>Python · MATLAB · LaTeX · ROS 2</p></div><div><h3>Experienced</h3><p>C/C++ · Arduino</p></div><div><h3>Simulation & platforms</h3><p>Gazebo · 2D swarm simulation · 3D EM modelling · LEO Rover · Clearpath Jackal</p></div><div><h3>Languages</h3><p>English & Welsh (fluent)</p></div></div></div></section>
  <section id="projects" class="projects-section"><div class="container section"><div class="section-heading"><div><p class="eyebrow">02 / SELECTED PROJECTS</p><h2>Research & engineering projects.</h2></div><p><span class="muted">Project case studies coming soon. The examples below are placeholders.</span></p></div><div class="project-grid">{projects.map(p => <a class="project-card" href={`${base}projects/${p.slug}/`}><div class={`project-image ${p.type}`}><span class="image-index">PROJECT / {p.number}</span><span class="image-placeholder">[ PROJECT IMAGE ]</span><span class="image-caption">{p.type.toUpperCase()} STUDY</span><span class="image-arrow">↗</span></div><div class="project-content"><p class="eyebrow">{p.category}</p><h3>{p.title}<span>↗</span></h3><p>{p.summary}</p><div class="tags">{p.tags.map(tag => <span>{tag}</span>)}</div></div></a>)}</div></div></section>
  <section id="background" class="container section"><div class="section-heading"><div><p class="eyebrow">03 / BACKGROUND</p><h2>Education & experience.</h2></div><a class="text-link" href={`${base}cv/`}>View CV <span>↗</span></a></div><div class="background-grid"><div><h3 class="column-title">Education</h3><article class="timeline-item"><p class="date">2024 — 2028 (EXPECTED)</p><h4>PhD in Engineering Mathematics</h4><p class="institution">University of Bristol</p><p>Thesis: Swarm-Enabled Spatial Intelligence</p></article><article class="timeline-item"><p class="date">2020 — 2024</p><h4>MEng in Engineering Mathematics</h4><p class="institution">University of Bristol</p><p>First Class Honours · Dissertation: “Anti-aligning robots”</p></article></div><div><h3 class="column-title">Experience</h3><article class="timeline-item"><p class="date">JUNE 2023 — PRESENT</p><h4>Consultant Engineer</h4><p class="institution">SportsViz · Part-time, remote</p><p>Researching novel data interpretation and artificial intelligence methods for elite sports performance analysis, in a project with the Football Association of Wales (FAW).</p><ul class="experience-points"><li>Authored technical reports reviewing the literature and setting out potential future research directions.</li><li>Demonstrated AI and data analysis capabilities for international-level sports performance analysis, engaging with clients from varied professional backgrounds.</li></ul></article><article class="timeline-item"><p class="date">SEPTEMBER 2023 — PRESENT</p><h4>Graduate Teaching Support</h4><p class="institution">University of Bristol</p><p>Support undergraduate and master’s students across a range of units and assignments.</p><ul class="experience-points"><li>Provide academic support in technical writing and research methodologies, including marking and one-to-one supervision of a master’s dissertation.</li><li>Quickly develop an understanding of unfamiliar topics to support student work, and coordinate meetings across multiple student groups.</li></ul></article></div></div></section>
  <section class="container section publications"><p class="eyebrow">04 / PUBLICATIONS</p><h2>Published research.</h2><article class="publication"><span class="date">SSRR<br/>2025</span><div><h3>Spatially Intelligent Patrol Routes for Concealed Emitter Localization by Robot Swarms</h3><p><strong>Adam Morris</strong>, Timothy Pelham, Edmund R. Hunt</p><p>IEEE International Symposium on Safety, Security, and Rescue Robotics · Galway, Ireland · 29–31 October 2025</p><p><a href="https://ieeexplore.ieee.org/document/11391260">IEEE Xplore ↗</a></p></div></article></section>
  <section id="contact" class="contact-section"><div class="container contact-inner"><div><p class="eyebrow">05 / CONTACT</p><h2>Let's talk robotics<br />& RF sensing.</h2><p>I welcome conversations about autonomous systems, defence and security research, engineering opportunities, and collaboration.</p></div><div class="contact-links"><a href="mailto:adamrhysmorris@gmail.com">adamrhysmorris@gmail.com <span>↗</span></a><div class="social-placeholders"><a href="https://github.com/ks20447">GitHub ↗</a><a href="https://www.linkedin.com/in/adam-morris-eng-maths/">LinkedIn ↗</a><a href="https://scholar.google.com/citations?hl=en&amp;user=NnjMzeMAAAAJ">Google Scholar ↗</a></div><div class="website-qr"><a href="https://ks20447.github.io/" aria-label="Open Adam Morris’s website"><img src={`${base}adam-morris-website-qr.png`} width="160" height="160" alt="QR code for https://ks20447.github.io/" loading="lazy" /></a><div><h3>Open on your phone</h3><p>Scan with your phone’s camera.</p><a href={`${base}adam-morris-website-qr.png`} download="Adam-Morris-Website-QR.png">Download QR code ↓</a></div></div></div></div></section>
</Layout>
