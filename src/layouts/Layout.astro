---
import '../styles/global.css';
const { title = 'Adam Morris — Robotics & Engineering', description = 'Adam Morris, Engineering Mathematics PhD researcher at the University of Bristol. Swarm robotics and RF sensing research with relevance to defence and security.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-palette="slate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header"><div class="nav-wrap">
      <a href={base} class="brand" aria-label="Adam Morris home"><span class="brand-mark">am<span>.</span></span><span class="brand-name">Adam Morris</span></a>
      <nav aria-label="Main navigation"><a href={`${base}#about`}>About</a><a href={`${base}#projects`}>Projects</a><a href={`${base}#background`}>Background</a><a href={`${base}#contact`}>Contact</a></nav>

      <button id="theme-toggle" class="theme-toggle" aria-label="Switch colour theme" title="Switch colour theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z"/></svg></button>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="container footer"><a href={base} class="footer-name">Adam Morris<span>.</span></a><span>Swarm robotics · RF sensing · Autonomous systems</span><span>© {new Date().getFullYear()}</span></footer>
    <script>
      const button = document.getElementById('theme-toggle');
      function updateLabel() { button?.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} mode`); }
      updateLabel();
      button?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        updateLabel();
      });
    </script>
  </body>
</html>
